# HER AI — Environment Configuration
# Copy this to .env and fill in your values.

APP_NAME=HER AI
APP_ENV=development
DEBUG=True

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/her_ai_db

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120

# RAG Configuration
RAG_TOP_K=5

# Provider Selection: ollama | groq | gemini | openrouter
LLM_PROVIDER=ollama
LLM_ENABLE_FALLBACK=true

# Cloud Providers (optional — leave blank for local-only mode)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
